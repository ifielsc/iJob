# Include inside http {}. Internal example behind an existing TLS gateway.
# Adjust root/upstream; do not expose this plain HTTP listener publicly.
upstream ijob_backend {
    server 127.0.0.1:8080;
}
server {
    listen 127.0.0.1:8088;
    server_name _;
    root /opt/ijob/web/dist;
    index index.html;
    location /api/ {
        proxy_pass http://ijob_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream off;
    }
    location /actuator {
        return 404;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
