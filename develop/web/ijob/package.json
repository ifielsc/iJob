{
  "name": "ijob-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:runtime": "node tools/check-runtime.mjs",
    "check": "pnpm check:runtime && pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm format:check && pnpm test && pnpm build && pnpm check:bundle",
    "check:bundle": "node tools/check-bundle-budget.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "3.1.1",
    "@lezer/highlight": "1.2.3",
    "@lucide/vue": "1.47.0",
    "@tanstack/vue-query": "5.103.1",
    "@vue-flow/core": "1.48.2",
    "@vue/devtools-api": "8.2.1",
    "codemirror": "6.0.2",
    "lossless-json": "4.3.1",
    "naive-ui": "2.45.3",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.12.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
