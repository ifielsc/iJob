server.address: 127.0.0.1
server.port: 18090
spring.datasource.url: jdbc:sqlite:E:/iJobData/platform.db
spring.datasource.driver-class-name: org.sqlite.JDBC
spring.datasource.username: ''
spring.datasource.password: ''
spring.datasource.hikari.maximum-pool-size: 4
spring.flyway.enabled: true
app.runtime.mode: STANDALONE
app.runtime.instance-name: windows-a
app.runtime.groups: default
app.auth.mode: STATIC
app.auth.username: REPLACE_WITH_ADMIN_NAME
app.auth.password-hash: 'REPLACE_WITH_BCRYPT_HASH'
app.security.aes.key: 'REPLACE_WITH_BASE64_32_BYTE_KEY'
app.security.aes.key-id: release-key-1
app.schedule.enabled: true
app.notification.outbox.enabled: true
app.event.recovery.enabled: true
app.runtime.maintenance.enabled: true
app.retention.enabled: false
app.plugin.etl.enabled: true
app.plugin.batch-etl.enabled: true
app.plugin.local-jar.enabled: false
app.event.ingress.enabled: false
app.plugin.local-jar.root-directory: E:/iJobData/plugins
