<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifelio.ijob.infra.mapper.coordination.DatabaseClockMapper">
    <select id="currentTimestamp" resultType="java.time.LocalDateTime">
        SELECT CURRENT_TIMESTAMP(3)
    </select>
    <select id="currentTimestamp" databaseId="postgresql"
            resultType="java.time.LocalDateTime">
        SELECT LOCALTIMESTAMP(3)
    </select>

<select id="currentTimestamp" databaseId="sqlite"
            resultType="java.time.LocalDateTime">
        SELECT strftime('%Y-%m-%d %H:%M:%f','now')
    </select>

<select id="currentTimestamp" databaseId="oracle"
            resultType="java.time.LocalDateTime">
        SELECT CAST(SYS_EXTRACT_UTC(SYSTIMESTAMP) AS TIMESTAMP(3)) FROM dual
    </select>

<select id="currentTimestamp" databaseId="sqlserver"
            resultType="java.time.LocalDateTime">
        SELECT SYSUTCDATETIME()
    </select>
</mapper>
