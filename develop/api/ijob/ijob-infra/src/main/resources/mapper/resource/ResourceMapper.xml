<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifelio.ijob.infra.mapper.resource.ResourceMapper">

    <resultMap id="ResourceResultMap"
               type="com.ifelio.ijob.infra.entity.resource.Resource">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="type" column="type"
                javaType="com.ifelio.ijob.contract.enums.ResourceType"/>
        <result property="config" column="config"/>
        <result property="enabled" column="enabled"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap id="ResourceListResultMap"
               type="com.ifelio.ijob.contract.resource.ResourceListDTO">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="type" column="type"
                javaType="com.ifelio.ijob.contract.enums.ResourceType"/>
        <result property="enabled" column="enabled"/>
        <result property="description" column="description"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="ResourceColumns">
        id,
        code,
        name,
        type,
        config,
        enabled,
        description,
        create_time,
        update_time
    </sql>

    <select id="selectDtoList"
            parameterType="com.ifelio.ijob.contract.resource.ResourcePageQuery"
            resultMap="ResourceListResultMap">
        SELECT
            id,
            code,
            name,
            type,
            enabled,
            description,
            update_time
        FROM ifj_resource
        <where>
            <if test="code != null and code.trim() != ''">
                code LIKE CONCAT('%', #{code}, '%')
            </if>
            <if test="name != null and name.trim() != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="selectDtoList" databaseId="postgresql"
            parameterType="com.ifelio.ijob.contract.resource.ResourcePageQuery"
            resultMap="ResourceListResultMap">
        SELECT id, code, name, type, enabled, description, update_time
        FROM ifj_resource
        <where>
            <if test="code != null and code.trim() != ''">
                LOWER(code) LIKE LOWER(CONCAT('%', #{code}, '%'))
            </if>
            <if test="name != null and name.trim() != ''">
                AND LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectDtoList" databaseId="sqlite"
            parameterType="com.ifelio.ijob.contract.resource.ResourcePageQuery"
            resultMap="ResourceListResultMap">
        SELECT id, code, name, type, enabled, description, update_time
        FROM ifj_resource
        <where>
            <if test="code != null and code.trim() != ''">
                LOWER(code) LIKE LOWER(('%' || #{code} || '%'))
            </if>
            <if test="name != null and name.trim() != ''">
                AND LOWER(name) LIKE LOWER(('%' || #{name} || '%'))
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectDtoList" databaseId="oracle"
            parameterType="com.ifelio.ijob.contract.resource.ResourcePageQuery"
            resultMap="ResourceListResultMap">
        SELECT id, code, name, type, enabled, description, update_time
        FROM ifj_resource
        <where>
            <if test="code != null and code.trim() != ''">
                LOWER(code) LIKE LOWER(('%' || #{code} || '%'))
            </if>
            <if test="name != null and name.trim() != ''">
                AND LOWER(name) LIKE LOWER(('%' || #{name} || '%'))
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectDtoList" databaseId="sqlserver"
            parameterType="com.ifelio.ijob.contract.resource.ResourcePageQuery"
            resultMap="ResourceListResultMap">
        SELECT id, code, name, type, enabled, description, update_time
        FROM ifj_resource
        <where>
            <if test="code != null and code.trim() != ''">
                LOWER(code) LIKE LOWER(CONCAT('%', #{code}, '%'))
            </if>
            <if test="name != null and name.trim() != ''">
                AND LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="selectById" resultMap="ResourceResultMap">
        SELECT
        <include refid="ResourceColumns"/>
        FROM ifj_resource
        WHERE id = #{id}
    </select>

    <select id="selectIdsForUpdate" resultType="java.lang.Long">
        SELECT id
        FROM ifj_resource
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
        FOR UPDATE
    </select>

<select id="selectIdsForUpdate" databaseId="sqlite" resultType="java.lang.Long">
        SELECT id
        FROM ifj_resource
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

<select id="selectIdsForUpdate" databaseId="oracle" resultType="java.lang.Long">
        SELECT id
        FROM ifj_resource
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
        FOR UPDATE
    </select>

<select id="selectIdsForUpdate" databaseId="sqlserver" resultType="java.lang.Long">
        SELECT id
        FROM ifj_resource WITH (UPDLOCK, HOLDLOCK, ROWLOCK)
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

    <select id="selectByCode" resultMap="ResourceResultMap">
        SELECT
        <include refid="ResourceColumns"/>
        FROM ifj_resource
        WHERE code = #{code}
    </select>

    <insert id="insert"
            parameterType="com.ifelio.ijob.infra.entity.resource.Resource">
        INSERT INTO ifj_resource (
            id,
            code,
            name,
            type,
            config,
            enabled,
            description,
            create_time,
            update_time
        ) VALUES (
            #{id},
            #{code},
            #{name},
            #{type},
            #{config},
            #{enabled},
            #{description},
            #{createTime},
            #{updateTime}
        )
    </insert>

    <update id="updateById"
            parameterType="com.ifelio.ijob.infra.entity.resource.Resource">
        UPDATE ifj_resource
        SET code = #{code},
            name = #{name},
            type = #{type},
            config = #{config},
            enabled = #{enabled},
            description = #{description},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ifj_resource
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM ifj_resource
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </delete>

<select id="selectSummariesByIds" resultType="com.ifelio.ijob.contract.resource.ResourceListDTO">
        SELECT id, name, type, enabled FROM ifj_resource
        WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
