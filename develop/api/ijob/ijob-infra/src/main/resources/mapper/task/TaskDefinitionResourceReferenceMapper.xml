<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifelio.ijob.infra.mapper.task.TaskDefinitionResourceReferenceMapper">

    <resultMap id="ResourceReferenceResultMap"
               type="com.ifelio.ijob.infra.entity.task.TaskDefinition">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="pluginType" column="plugin_type"
                javaType="com.ifelio.ijob.contract.enums.PluginType"/>
        <result property="pluginConfig" column="plugin_config"/>
    </resultMap>

    <select id="selectMaxDefinitionId" resultType="java.lang.Long">
        SELECT MAX(id) FROM ifj_task_definition
    </select>

    <select id="selectDefinitionBatch"
            resultMap="ResourceReferenceResultMap">
        SELECT id, task_id, plugin_type, plugin_config
        FROM ifj_task_definition
        WHERE id &gt; #{afterId} AND id &lt;= #{upperId}
        ORDER BY id
    </select>

</mapper>
