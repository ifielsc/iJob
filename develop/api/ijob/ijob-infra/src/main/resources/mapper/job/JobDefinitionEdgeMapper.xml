<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifelio.ijob.infra.mapper.job.JobDefinitionEdgeMapper">

    <resultMap id="JobDefinitionEdgeResultMap"
               type="com.ifelio.ijob.infra.entity.job.JobDefinitionEdge">
        <id property="id" column="id"/>
        <result property="definitionId" column="definition_id"/>
        <result property="fromNodeId" column="from_node_id"/>
        <result property="toNodeId" column="to_node_id"/>
        <result property="routeKey" column="route_key"/>
        <result property="routePriority" column="route_priority"/>
        <result property="defaultRoute" column="default_route"/>
        <result property="conditionVersion" column="condition_version"/>
        <result property="conditionPayload" column="condition_payload"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="JobDefinitionEdgeColumns">
        id,
        definition_id,
        from_node_id,
        to_node_id,
        route_key,
        route_priority,
        default_route,
        condition_version,
        condition_payload,
        create_time
    </sql>

    <select id="selectListByDefinitionId"
            resultMap="JobDefinitionEdgeResultMap">
        SELECT
        <include refid="JobDefinitionEdgeColumns"/>
        FROM ifj_job_definition_edge
        WHERE definition_id = #{definitionId}
        ORDER BY id ASC
    </select>

    <insert id="insert"
            parameterType="com.ifelio.ijob.infra.entity.job.JobDefinitionEdge">
        INSERT INTO ifj_job_definition_edge (
            id,
            definition_id,
            from_node_id,
            to_node_id,
            route_key,
            route_priority,
            default_route,
            condition_version,
            condition_payload,
            create_time
        ) VALUES (
            #{id},
            #{definitionId},
            #{fromNodeId},
            #{toNodeId},
            #{routeKey},
            #{routePriority},
            #{defaultRoute},
            #{conditionVersion},
            #{conditionPayload},
            #{createTime}
        )
    </insert>

</mapper>
