<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifielsc.ijob.infra.mapper.job.JobDefinitionNodeMapper">

    <resultMap id="JobDefinitionNodeResultMap"
               type="com.ifielsc.ijob.infra.entity.job.JobDefinitionNode">
        <id property="id" column="id"/>
        <result property="definitionId" column="definition_id"/>
        <result property="nodeKey" column="node_key"/>
        <result property="name" column="name"/>
        <result property="nodeKind" column="node_kind"
                javaType="com.ifielsc.ijob.contract.enums.JobNodeKind"/>
        <result property="gatewayMode" column="gateway_mode"
                javaType="com.ifielsc.ijob.contract.enums.GatewayMode"/>
        <result property="nodeType" column="node_type"
                javaType="com.ifielsc.ijob.contract.enums.TargetType"/>
        <result property="refId" column="ref_id"/>
        <result property="refDefinitionId" column="ref_definition_id"/>
        <result property="refTaskDefinitionId"
                column="ref_task_definition_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="JobDefinitionNodeColumns">
        id,
        definition_id,
        node_key,
        name,
        node_kind,
        gateway_mode,
        node_type,
        ref_id,
        ref_definition_id,
        ref_task_definition_id,
        create_time
    </sql>

    <select id="selectListByDefinitionId"
            resultMap="JobDefinitionNodeResultMap">
        SELECT
        <include refid="JobDefinitionNodeColumns"/>
        FROM ifj_job_definition_node
        WHERE definition_id = #{definitionId}
        ORDER BY id ASC
    </select>

    <insert id="insert"
            parameterType="com.ifielsc.ijob.infra.entity.job.JobDefinitionNode">
        INSERT INTO ifj_job_definition_node (
            id,
            definition_id,
            node_key,
            name,
            node_kind,
            gateway_mode,
            node_type,
            ref_id,
            ref_definition_id,
            ref_task_definition_id,
            create_time
        ) VALUES (
            #{id},
            #{definitionId},
            #{nodeKey},
            #{name},
            #{nodeKind},
            #{gatewayMode},
            #{nodeType},
            #{refId},
            #{refDefinitionId},
            #{refTaskDefinitionId},
            #{createTime}
        )
    </insert>

</mapper>
