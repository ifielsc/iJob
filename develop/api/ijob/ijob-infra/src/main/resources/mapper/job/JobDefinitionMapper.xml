<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifelio.ijob.infra.mapper.job.JobDefinitionMapper">

    <resultMap id="JobDefinitionResultMap"
               type="com.ifelio.ijob.infra.entity.job.JobDefinition">
        <id property="id" column="id"/>
        <result property="jobId" column="job_id"/>
        <result property="revision" column="revision"/>
        <result property="name" column="name"/>
        <result property="timeout" column="timeout"/>
        <result property="enabled" column="enabled"/>
        <result property="description" column="description"/>
        <result property="layout" column="layout_json"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="JobDefinitionColumns">
        id,
        job_id,
        revision,
        name,
        timeout,
        enabled,
        description,
        layout_json,
        create_time
    </sql>

    <select id="selectById" resultMap="JobDefinitionResultMap">
        SELECT
        <include refid="JobDefinitionColumns"/>
        FROM ifj_job_definition
        WHERE id = #{id}
    </select>

    <select id="selectListByJobId" resultMap="JobDefinitionResultMap">
        SELECT
        <include refid="JobDefinitionColumns"/>
        FROM ifj_job_definition
        WHERE job_id = #{jobId}
        ORDER BY revision ASC, id ASC
    </select>

    <insert id="insert"
            parameterType="com.ifelio.ijob.infra.entity.job.JobDefinition">
        INSERT INTO ifj_job_definition (
            id,
            job_id,
            revision,
            name,
            timeout,
            enabled,
            description,
        layout_json,
            create_time
        ) VALUES (
            #{id},
            #{jobId},
            #{revision},
            #{name},
            #{timeout},
            #{enabled},
            #{description},
            #{layout},
            #{createTime}
        )
    </insert>

</mapper>
