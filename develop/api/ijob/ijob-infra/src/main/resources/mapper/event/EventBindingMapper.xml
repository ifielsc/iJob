<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifielsc.ijob.infra.mapper.event.EventBindingMapper">
    <sql id="columns">id, target_type, target_id, event_code, enabled,
        create_time, update_time</sql>
    <select id="selectListByEventCode"
            resultType="com.ifielsc.ijob.infra.entity.event.EventBinding">
        SELECT <include refid="columns"/>
        FROM ifj_event_binding
        WHERE event_code = #{eventCode}
          AND enabled = TRUE
        ORDER BY id ASC
    </select>

<select id="selectListByEventCode"
            resultType="com.ifielsc.ijob.infra.entity.event.EventBinding" databaseId="oracle">
        SELECT <include refid="columns"/>
        FROM ifj_event_binding
        WHERE event_code = #{eventCode}
          AND enabled = 1
        ORDER BY id ASC
    </select>
    <select id="selectListByTarget"
            resultType="com.ifielsc.ijob.infra.entity.event.EventBinding">
        SELECT <include refid="columns"/>
        FROM ifj_event_binding
        WHERE target_type = #{targetType} AND target_id = #{targetId}
        ORDER BY id ASC
    </select>
    <select id="selectById"
            resultType="com.ifielsc.ijob.infra.entity.event.EventBinding">
        SELECT <include refid="columns"/>
        FROM ifj_event_binding WHERE id = #{id}
    </select>
    <select id="selectIdsForUpdate" resultType="java.lang.Long">
        SELECT id
        FROM ifj_event_binding
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
        FOR UPDATE
    </select>

<select id="selectIdsForUpdate" databaseId="sqlite" resultType="java.lang.Long">
        SELECT id
        FROM ifj_event_binding
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

<select id="selectIdsForUpdate" databaseId="oracle" resultType="java.lang.Long">
        SELECT id
        FROM ifj_event_binding
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

<select id="selectIdsForUpdate" databaseId="sqlserver" resultType="java.lang.Long">
        SELECT id
        FROM ifj_event_binding
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>
    <select id="selectByTargetAndEvent"
            resultType="com.ifielsc.ijob.infra.entity.event.EventBinding">
        SELECT <include refid="columns"/>
        FROM ifj_event_binding
        WHERE target_type = #{targetType} AND target_id = #{targetId}
          AND event_code = #{eventCode}
    </select>
    <insert id="insert"
            parameterType="com.ifielsc.ijob.infra.entity.event.EventBinding">
        INSERT INTO ifj_event_binding
            (id, target_type, target_id, event_code, enabled,
             create_time, update_time)
        VALUES (#{id}, #{targetType}, #{targetId}, #{eventCode}, #{enabled},
                #{createTime}, #{updateTime})
    </insert>
    <update id="updateEnabledById">
        UPDATE ifj_event_binding
        SET enabled = #{enabled}, update_time = #{updateTime}
        WHERE id = #{id}
    </update>
    <update id="disableByTargetId">
        UPDATE ifj_event_binding SET enabled = #{disabled}, update_time = #{updateTime}
        WHERE target_type = #{targetType} AND target_id = #{targetId}
    </update>
    <delete id="deleteById">
        DELETE FROM ifj_event_binding WHERE id = #{id}
    </delete>
    <delete id="deleteByIds">
        DELETE FROM ifj_event_binding
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </delete>
    <select id="selectListByEventCode" databaseId="sqlserver"
            resultType="com.ifielsc.ijob.infra.entity.event.EventBinding">
        SELECT <include refid="columns"/> FROM ifj_event_binding
        WHERE event_code = #{eventCode} AND enabled = 1
        ORDER BY id ASC
    </select>
</mapper>
