<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifelio.ijob.infra.mapper.task.TaskReferenceMapper">

    <select id="selectExistingIds" resultType="java.lang.Long">
        SELECT id
        FROM ifj_task
        WHERE id IN
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
          AND retired = <choose><when test="_databaseId == 'sqlserver'">0</when><otherwise>FALSE</otherwise></choose>
          AND current_task_definition_id IS NOT NULL
          AND current_revision IS NOT NULL
        ORDER BY id ASC
    </select>

<select id="selectExistingIds" resultType="java.lang.Long" databaseId="oracle">
        SELECT id
        FROM ifj_task
        WHERE id IN
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
          AND retired = 0
          AND current_task_definition_id IS NOT NULL
          AND current_revision IS NOT NULL
        ORDER BY id ASC
    </select>

</mapper>
