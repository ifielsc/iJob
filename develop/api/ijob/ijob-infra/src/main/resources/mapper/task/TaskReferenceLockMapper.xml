<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifielsc.ijob.infra.mapper.task.TaskReferenceLockMapper">

    <select id="lockExistingIds" resultType="java.lang.Long">
        SELECT id
        FROM ifj_task
        WHERE id IN
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
          AND retired = FALSE
          AND current_task_definition_id IS NOT NULL
          AND current_revision IS NOT NULL
        ORDER BY id ASC
        FOR UPDATE
    </select>

<select id="lockExistingIds" databaseId="sqlite" resultType="java.lang.Long">
        SELECT id
        FROM ifj_task
        WHERE id IN
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
          AND retired = FALSE
          AND current_task_definition_id IS NOT NULL
          AND current_revision IS NOT NULL
        ORDER BY id ASC
    </select>

<select id="lockExistingIds" databaseId="oracle" resultType="java.lang.Long">
        SELECT id
        FROM ifj_task
        WHERE id IN
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
          AND retired = 0
          AND current_task_definition_id IS NOT NULL
          AND current_revision IS NOT NULL
        ORDER BY id ASC
    </select>

<select id="lockExistingIds" databaseId="sqlserver" resultType="java.lang.Long">
        SELECT id
        FROM ifj_task
        WHERE id IN
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
          AND retired = 0
          AND current_task_definition_id IS NOT NULL
          AND current_revision IS NOT NULL
        ORDER BY id ASC
    </select>

    <select id="selectCurrentTaskDefinitionId" resultType="java.lang.Long">
        SELECT current_task_definition_id
        FROM ifj_task
        WHERE id = #{taskId}
          AND retired = <choose><when test="_databaseId == 'sqlserver'">0</when><otherwise>FALSE</otherwise></choose>
    </select>

<select id="selectCurrentTaskDefinitionId" resultType="java.lang.Long" databaseId="oracle">
        SELECT current_task_definition_id
        FROM ifj_task
        WHERE id = #{taskId}
          AND retired = 0
    </select>

</mapper>
