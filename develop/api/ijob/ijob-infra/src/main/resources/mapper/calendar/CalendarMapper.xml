<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifelio.ijob.infra.mapper.calendar.CalendarMapper">

    <resultMap id="CalendarResultMap"
               type="com.ifelio.ijob.infra.entity.calendar.Calendar">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="workdaysMask" column="workdays_mask"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="CalendarColumns">
        id,
        name,
        workdays_mask,
        description,
        create_time,
        update_time
    </sql>

    <select id="selectList"
            parameterType="com.ifelio.ijob.contract.calendar.CalendarPageQuery"
            resultMap="CalendarResultMap">
        SELECT
        <include refid="CalendarColumns"/>
        FROM ifj_calendar
        <where>
            <if test="name != null and name.trim() != ''">
                name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="selectList" databaseId="postgresql"
            parameterType="com.ifelio.ijob.contract.calendar.CalendarPageQuery"
            resultMap="CalendarResultMap">
        SELECT <include refid="CalendarColumns"/>
        FROM ifj_calendar
        <where>
            <if test="name != null and name.trim() != ''">
                LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectList" databaseId="sqlite"
            parameterType="com.ifelio.ijob.contract.calendar.CalendarPageQuery"
            resultMap="CalendarResultMap">
        SELECT <include refid="CalendarColumns"/>
        FROM ifj_calendar
        <where>
            <if test="name != null and name.trim() != ''">
                LOWER(name) LIKE LOWER(('%' || #{name} || '%'))
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectList" databaseId="oracle"
            parameterType="com.ifelio.ijob.contract.calendar.CalendarPageQuery"
            resultMap="CalendarResultMap">
        SELECT <include refid="CalendarColumns"/>
        FROM ifj_calendar
        <where>
            <if test="name != null and name.trim() != ''">
                LOWER(name) LIKE LOWER(('%' || #{name} || '%'))
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectList" databaseId="sqlserver"
            parameterType="com.ifelio.ijob.contract.calendar.CalendarPageQuery"
            resultMap="CalendarResultMap">
        SELECT <include refid="CalendarColumns"/>
        FROM ifj_calendar
        <where>
            <if test="name != null and name.trim() != ''">
                LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="selectById" resultMap="CalendarResultMap">
        SELECT
        <include refid="CalendarColumns"/>
        FROM ifj_calendar
        WHERE id = #{id}
    </select>

    <select id="selectIdsForUpdate" resultType="java.lang.Long">
        SELECT id
        FROM ifj_calendar
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
        FOR UPDATE
    </select>

<select id="selectIdsForUpdate" databaseId="sqlite" resultType="java.lang.Long">
        SELECT id
        FROM ifj_calendar
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

<select id="selectIdsForUpdate" databaseId="oracle" resultType="java.lang.Long">
        SELECT id
        FROM ifj_calendar
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

<select id="selectIdsForUpdate" databaseId="sqlserver" resultType="java.lang.Long">
        SELECT id
        FROM ifj_calendar
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

    <select id="selectByName" resultMap="CalendarResultMap">
        SELECT
        <include refid="CalendarColumns"/>
        FROM ifj_calendar
        WHERE name = #{name}
    </select>

    <insert id="insert"
            parameterType="com.ifelio.ijob.infra.entity.calendar.Calendar">
        INSERT INTO ifj_calendar (
            id,
            name,
            workdays_mask,
            description,
            create_time,
            update_time
        ) VALUES (
            #{id},
            #{name},
            #{workdaysMask},
            #{description},
            #{createTime},
            #{updateTime}
        )
    </insert>

    <update id="updateById"
            parameterType="com.ifelio.ijob.infra.entity.calendar.Calendar">
        UPDATE ifj_calendar
        SET name = #{name},
            workdays_mask = #{workdaysMask},
            description = #{description},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ifj_calendar
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM ifj_calendar
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </delete>

</mapper>
