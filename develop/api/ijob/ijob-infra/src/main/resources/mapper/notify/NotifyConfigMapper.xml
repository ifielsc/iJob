<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifielsc.ijob.infra.mapper.notify.NotifyConfigMapper">

    <resultMap id="NotifyConfigResultMap"
               type="com.ifielsc.ijob.infra.entity.notify.NotifyConfig">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"
                javaType="com.ifielsc.ijob.contract.enums.NotifyType"/>
        <result property="config" column="config"/>
        <result property="enabled" column="enabled"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap id="NotifyConfigListResultMap"
               type="com.ifielsc.ijob.contract.notify.NotifyConfigListDTO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"
                javaType="com.ifielsc.ijob.contract.enums.NotifyType"/>
        <result property="enabled" column="enabled"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="NotifyConfigColumns">
        id,
        name,
        type,
        config,
        enabled,
        create_time,
        update_time
    </sql>

    <select id="selectDtoList"
            parameterType="com.ifielsc.ijob.contract.notify.NotifyConfigPageQuery"
            resultMap="NotifyConfigListResultMap">
        SELECT
            id,
            name,
            type,
            enabled,
            update_time
        FROM ifj_notify_config
        <where>
            <if test="name != null and name.trim() != ''">
                name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="selectDtoList" databaseId="postgresql"
            parameterType="com.ifielsc.ijob.contract.notify.NotifyConfigPageQuery"
            resultMap="NotifyConfigListResultMap">
        SELECT id, name, type, enabled, update_time
        FROM ifj_notify_config
        <where>
            <if test="name != null and name.trim() != ''">
                LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectDtoList" databaseId="sqlite"
            parameterType="com.ifielsc.ijob.contract.notify.NotifyConfigPageQuery"
            resultMap="NotifyConfigListResultMap">
        SELECT id, name, type, enabled, update_time
        FROM ifj_notify_config
        <where>
            <if test="name != null and name.trim() != ''">
                LOWER(name) LIKE LOWER(('%' || #{name} || '%'))
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectDtoList" databaseId="oracle"
            parameterType="com.ifielsc.ijob.contract.notify.NotifyConfigPageQuery"
            resultMap="NotifyConfigListResultMap">
        SELECT id, name, type, enabled, update_time
        FROM ifj_notify_config
        <where>
            <if test="name != null and name.trim() != ''">
                LOWER(name) LIKE LOWER(('%' || #{name} || '%'))
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

<select id="selectDtoList" databaseId="sqlserver"
            parameterType="com.ifielsc.ijob.contract.notify.NotifyConfigPageQuery"
            resultMap="NotifyConfigListResultMap">
        SELECT id, name, type, enabled, update_time
        FROM ifj_notify_config
        <where>
            <if test="name != null and name.trim() != ''">
                LOWER(name) LIKE LOWER(CONCAT('%', #{name}, '%'))
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="selectById" resultMap="NotifyConfigResultMap">
        SELECT
        <include refid="NotifyConfigColumns"/>
        FROM ifj_notify_config
        WHERE id = #{id}
    </select>

    <select id="selectIdsForUpdate" resultType="java.lang.Long">
        SELECT id
        FROM ifj_notify_config
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
        FOR UPDATE
    </select>

<select id="selectIdsForUpdate" databaseId="sqlite" resultType="java.lang.Long">
        SELECT id
        FROM ifj_notify_config
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

<select id="selectIdsForUpdate" databaseId="oracle" resultType="java.lang.Long">
        SELECT id
        FROM ifj_notify_config
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
        FOR UPDATE
    </select>

<select id="selectIdsForUpdate" databaseId="sqlserver" resultType="java.lang.Long">
        SELECT id
        FROM ifj_notify_config WITH (UPDLOCK, HOLDLOCK, ROWLOCK)
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

    <select id="countById" resultType="int">
        SELECT COUNT(1)
        FROM ifj_notify_config
        WHERE id = #{id}
    </select>

    <insert id="insert"
            parameterType="com.ifielsc.ijob.infra.entity.notify.NotifyConfig">
        INSERT INTO ifj_notify_config (
            id,
            name,
            type,
            config,
            enabled,
            create_time,
            update_time
        ) VALUES (
            #{id},
            #{name},
            #{type},
            #{config},
            #{enabled},
            #{createTime},
            #{updateTime}
        )
    </insert>

    <update id="updateById"
            parameterType="com.ifielsc.ijob.infra.entity.notify.NotifyConfig">
        UPDATE ifj_notify_config
        SET name = #{name},
            type = #{type},
            config = #{config},
            enabled = #{enabled},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ifj_notify_config
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM ifj_notify_config
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id"
                         open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </delete>

<select id="selectSummariesByIds" resultType="com.ifielsc.ijob.contract.notify.NotifyConfigListDTO">
        SELECT id, name, type, enabled FROM ifj_notify_config
        WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
