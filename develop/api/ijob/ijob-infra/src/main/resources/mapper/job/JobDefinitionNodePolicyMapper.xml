<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ifelio.ijob.infra.mapper.job.JobDefinitionNodePolicyMapper">

    <resultMap id="JobDefinitionNodePolicyResultMap"
               type="com.ifelio.ijob.infra.entity.job.JobDefinitionNodePolicy">
        <id property="id" column="id"/>
        <result property="definitionId" column="definition_id"/>
        <result property="nodeId" column="node_id"/>
        <result property="failStrategy" column="fail_strategy"
                javaType="com.ifelio.ijob.contract.enums.FailStrategy"/>
        <result property="executeCondition" column="execute_condition"
                javaType="com.ifelio.ijob.contract.enums.ExecuteCondition"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="JobDefinitionNodePolicyColumns">
        id,
        definition_id,
        node_id,
        fail_strategy,
        execute_condition,
        create_time
    </sql>

    <select id="selectListByDefinitionId"
            resultMap="JobDefinitionNodePolicyResultMap">
        SELECT
        <include refid="JobDefinitionNodePolicyColumns"/>
        FROM ifj_job_definition_node_policy
        WHERE definition_id = #{definitionId}
        ORDER BY node_id ASC, id ASC
    </select>

    <insert id="insert"
            parameterType="com.ifelio.ijob.infra.entity.job.JobDefinitionNodePolicy">
        INSERT INTO ifj_job_definition_node_policy (
            id,
            definition_id,
            node_id,
            fail_strategy,
            execute_condition,
            create_time
        ) VALUES (
            #{id},
            #{definitionId},
            #{nodeId},
            #{failStrategy},
            #{executeCondition},
            #{createTime}
        )
    </insert>

</mapper>
