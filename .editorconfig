root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{cmd,bat,ps1,sh}]
indent_style = space
indent_size = 4

